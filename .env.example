
# =============================================================
# Pinkmanager69 — Environment Variables
# =============================================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงก่อนรัน
# Copy this file to .env.local and fill in real values before running

# --- Supabase (ถ้าใช้ backend) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Staff Login Credentials ---
# ค่าเหล่านี้ใช้สำหรับ login หน้า Staff ในระบบ
# ถ้าไม่ใช้ env ให้ตั้งตรงใน store.ts (แต่ไม่แนะนำ)
STAFF_USERNAME=your_staff_username
STAFF_PASSWORD=your_staff_password
